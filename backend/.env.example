PORT=5000
JWT_SECRET=change_this_to_a_long_random_string_before_deploying
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
CORS_ORIGIN=http://localhost:5500

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Use either DATABASE_URL or the individual PG* variables.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=lms
# PGUSER=postgres
# PGPASSWORD=postgres

# ── SMTP (email sending) ──────────────────────────────────────────────────────
# Supports any SMTP provider: Gmail, SendGrid, Mailgun, AWS SES, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=LeadMS CRM
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ── App URLs (used in email links) ───────────────────────────────────────────
APP_URL=http://localhost:5500
FRONTEND_URL=http://localhost:5500

# ── Company Branding (fallback if DB not seeded) ──────────────────────────────
COMPANY_NAME=LeadMS CRM
COMPANY_EMAIL=admin@leadms.com
SUPPORT_EMAIL=support@leadms.com

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_TOKEN=your_whatsapp_bearer_token
WHATSAPP_FROM=+911234567890
WHATSAPP_ENABLED=false

# ── Feature flags ─────────────────────────────────────────────────────────────
ALLOW_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
